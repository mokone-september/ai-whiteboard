{
  "name": "ai-whiteboard",
  "version": "1.0.0",
  "private": true,
  "description": "A collaborative AI-powered whiteboard application",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "concurrently -k -n frontend,backend \"pnpm run dev:frontend\" \"pnpm run dev:backend\"",
    "dev:frontend": "pnpm --filter @ai-whiteboard/frontend dev",
    "build:frontend": "pnpm --filter @ai-whiteboard/frontend build",
    "lint:frontend": "pnpm --filter @ai-whiteboard/frontend lint",
    "dev:backend": "pnpm --filter @ai-whiteboard/backend dev",
    "build:backend": "pnpm --filter @ai-whiteboard/backend build",
    "lint:backend": "pnpm --filter @ai-whiteboard/backend lint",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "prettier --write",
    "*.{json,md,yml,yaml,css,html}": "prettier --write"
  }
}
